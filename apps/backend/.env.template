STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
ADMIN_URL=http://localhost:9000

# URL pública da storefront. Usada para gerar links em emails e como alvo do
# webhook de revalidação de cache (subscriber catalog-cache). Se ausente, cai
# para o primeiro valor de STORE_CORS.
STORE_URL=http://localhost:8000

# Secret compartilhado com a storefront (variável REVALIDATE_SECRET lá) para
# autorizar o webhook de invalidação de cache. Sem ele, novos produtos não
# aparecem na loja até o revalidate temporal (~5 min) ou um redeploy.
STOREFRONT_REVALIDATE_SECRET=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CAPTURE=false
STRIPE_AUTOMATIC_PAYMENT_METHODS=false

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_AUTO_CAPTURE=false
PAYPAL_WEBHOOK_ID=

SENDGRID_API_KEY=
SENDGRID_FROM=
EMAIL_LOGO_URL=

# UUID of the SendGrid Marketing List that newsletter subscribers are added to.
# The SENDGRID_API_KEY above must have Marketing > Contacts (Read/Write) scope.
SENDGRID_NEWSLETTER_LIST_ID=

# Cloudflare Turnstile — proteção contra bots nos formulários públicos
# (newsletter, rastreio de pedido, login, cadastro, checkout e transfer).
# Opcional: se ausente, o captcha é desabilitado em ambos os apps (graceful
# degradation). O secret fica só no backend; a storefront usa apenas a
# NEXT_PUBLIC_TURNSTILE_SITE_KEY (chave pública do widget).
TURNSTILE_SECRET_KEY=
