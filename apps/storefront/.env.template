# Variáveis de ambiente da storefront (Next.js 15). Copie para .env.local e
# preencha. Apenas NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY é obrigatória (verificada
# no boot por scripts/check-env-variables.js); as demais têm padrões ou são
# opcionais.

# Chave publicável do Medusa (obrigatória). Criada no admin do Medusa.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL do backend Medusa. Padrão: http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Região padrão (código de país ISO lowercase) quando não detectada via
# Cloudflare/Vercel. Padrão: dk
NEXT_PUBLIC_DEFAULT_REGION=dk

# URL pública da storefront (usada em links absolutos, OG, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Chave publicável do Stripe (front-end).
NEXT_PUBLIC_STRIPE_KEY=

# Secret compartilhado com o backend (STOREFRONT_REVALIDATE_SECRET lá) para
# autorizar o webhook de invalidação de cache. Sem ele, novos produtos só
# aparecem após o revalidate temporal (~5 min) ou um redeploy.
REVALIDATE_SECRET=

# Cloudflare Turnstile — proteção contra bots nos formulários públicos
# (newsletter, rastreio de pedido, login, cadastro, checkout e transfer).
# Opcional: se ausente, o captcha é desabilitado na storefront e o widget não
# renderiza (graceful degradation). O secret equivalente (TURNSTILE_SECRET_KEY)
# fica apenas no backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
